<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="553.0" prefWidth="737.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="crud.FuncionarioController">
    <children>
      <Label layoutX="55.0" layoutY="51.0" text="Nome" />
      <Label layoutX="45.0" layoutY="94.0" prefHeight="17.0" prefWidth="55.0" text="Matrícula" />
      <Label layoutX="58.0" layoutY="136.0" text="Salário" />
      <TextField fx:id="nomeInput" layoutX="104.0" layoutY="47.0" />
      <TextField fx:id="matriculaInput" layoutX="104.0" layoutY="90.0" />
      <TextField fx:id="salarioInput" layoutX="104.0" layoutY="132.0" />
      <TextField fx:id="especialidadeInput" layoutX="104.0" layoutY="171.0" />
      <TextField fx:id="scoreInput" layoutX="104.0" layoutY="214.0" />
      <RadioButton fx:id="radioGerente" layoutX="135.0" layoutY="239.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="69.0" selected="true" text="Gerente">
         <toggleGroup>
            <ToggleGroup fx:id="tipo" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="radioAtendente" layoutX="131.0" layoutY="277.0" mnemonicParsing="false" text="Atendente" toggleGroup="$tipo" />
      <RadioButton fx:id="radioMecanico" layoutX="131.0" layoutY="312.0" mnemonicParsing="false" text="Mecânico" toggleGroup="$tipo" />
        <Button fx:id="cadastrar" layoutX="136.0" layoutY="345.0" onAction="#cadastrar" text="Cadastrar" />
      <TableView fx:id="tabelaFuncionario" layoutX="272.0" layoutY="38.0" prefHeight="291.0" prefWidth="447.0">
        <columns>
          <TableColumn fx:id="nome" prefWidth="75.0" text="Nome" />
          <TableColumn fx:id="matricula" prefWidth="75.0" text="Matrícula" />
            <TableColumn fx:id="salario" prefWidth="75.0" text="Salário" />
            <TableColumn fx:id="tipoColuna" prefWidth="70.0" text="Tipo" />
            <TableColumn fx:id="especialidade" text="Especialidade" />
            <TableColumn fx:id="score" prefWidth="75.0" text="Score" />
        </columns>
      </TableView>
      <Accordion layoutX="35.0" layoutY="239.0" />
      <Button fx:id="deletar" layoutX="582.0" layoutY="332.0" onAction="#deletar" text="Deletar" />
      <Button fx:id="concluirEdicao" layoutX="120.0" layoutY="345.0" onAction="#concluirEdicao" text="Concluir edição" />
      <Label layoutX="369.0" layoutY="14.0" text="Funcionários" />
        <Label fx:id="label" layoutX="86.0" layoutY="409.0" minHeight="16" minWidth="69">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="editar" layoutX="357.0" layoutY="332.0" onAction="#editar" text="Editar" />
      <Button fx:id="voltar" layoutX="356.0" layoutY="332.0" onAction="#sairEdicao" text="Voltar" />
      <Button layoutX="369.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaVeiculo" text="Veículos" />
      <Button layoutX="459.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaManutencao" text="Manutenções" />
      <Button layoutX="577.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaLocacao" text="Locações" />
      <Label layoutX="22.0" layoutY="175.0" text="Especialidade" />
      <Label layoutX="58.0" layoutY="218.0" text="Score" />
      <Label layoutX="14.0" layoutY="243.0" prefHeight="102.0" prefWidth="88.0" text="Especialidade só será adicionada aos mecânicos, e o score aos atendentes" textAlignment="CENTER" wrapText="true" />
    </children>
</AnchorPane>
