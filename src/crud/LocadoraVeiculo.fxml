<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="553.0" prefWidth="737.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="crud.LocadoraVeiculoController">
    <children>
      <Label layoutX="55.0" layoutY="51.0" text="Modelo" />
      <Label layoutX="58.0" layoutY="94.0" text="Placa" />
      <Label layoutX="58.0" layoutY="136.0" text="Preço" />
      <TextField fx:id="modeloInput" layoutX="104.0" layoutY="47.0" />
      <TextField fx:id="placaInput" layoutX="104.0" layoutY="90.0" />
      <TextField fx:id="precoInput" layoutX="104.0" layoutY="132.0" />
      <RadioButton fx:id="radioMoto" layoutX="132.0" layoutY="206.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="55.0" selected="true" text="Moto">
         <toggleGroup>
            <ToggleGroup fx:id="tipo" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="radioCarro" layoutX="132.0" layoutY="246.0" mnemonicParsing="false" text="Carro" toggleGroup="$tipo" />
        <Button fx:id="cadastrar" layoutX="145.0" layoutY="307.0" onAction="#cadastrar" text="Cadastrar" />
      <TableView fx:id="tabelaVeiculos" layoutX="340.0" layoutY="38.0" prefHeight="168.0" prefWidth="326.0">
        <columns>
          <TableColumn fx:id="modelo" prefWidth="75.0" text="Modelo" />
          <TableColumn fx:id="placaColuna" prefWidth="75.0" text="Placa" />
            <TableColumn fx:id="precoColuna" prefWidth="75.0" text="Preço" />
            <TableColumn fx:id="tipoColuna" prefWidth="75.0" text="Tipo" />
        </columns>
      </TableView>
      <Accordion layoutX="35.0" layoutY="239.0" />
      <Button fx:id="deletar" layoutX="582.0" layoutY="219.0" onAction="#deletar" text="Deletar" />
      <Button fx:id="concluirEdicao" layoutX="130.0" layoutY="307.0" onAction="#concluirEdicao" text="Concluir edição" />
      <TableView fx:id="tabelaManutencoes" layoutX="369.0" layoutY="279.0" prefHeight="109.0" prefWidth="268.0">
        <columns>
            <TableColumn fx:id="nomeMecanico" prefWidth="128.0" text="Mêcanico" />
          <TableColumn fx:id="especialidade" prefWidth="137.0" text="Especialidade" />
        </columns>
      </TableView>
      <Label fx:id="labelManutencao" layoutX="369.0" layoutY="254.0" text="Manutenções" />
      <Label layoutX="369.0" layoutY="14.0" text="Veículos" />
        <Label fx:id="label" layoutX="86.0" layoutY="409.0" minHeight="16" minWidth="69">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="editar" layoutX="368.0" layoutY="219.0" onAction="#editar" text="Editar" />
      <Button fx:id="voltar" layoutX="367.0" layoutY="219.0" onAction="#sairEdicao" text="Voltar" />
      <Button layoutX="350.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaFuncionario" text="Funcionários" />
      <Button layoutX="459.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaManutencao" text="Manutenções" />
      <Button layoutX="577.0" layoutY="441.0" mnemonicParsing="false" onAction="#irTelaLocacao" text="Locações" />
      <Button fx:id="mostrarManutencoes" layoutX="437.0" layoutY="219.0" mnemonicParsing="false" onAction="#mostrarManutencoes" text="Mostrar manutenções" />
    </children>
</AnchorPane>
