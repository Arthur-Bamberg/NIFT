<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="553.0" prefWidth="737.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="crud.ProductController">
    <children>
      <Label layoutX="55.0" layoutY="51.0" text="Nome" />
      <Label layoutX="58.0" layoutY="94.0" text="URL" />
      <Label layoutX="58.0" layoutY="136.0" />
      <TextField fx:id="name" layoutX="104.0" layoutY="47.0" />
      <TextField fx:id="url" layoutX="104.0" layoutY="90.0" />
        <Button fx:id="cadastrar" layoutX="137.0" layoutY="242.0" onAction="#cadastrar" text="Cadastrar" />
      <TableView fx:id="productTable" layoutX="340.0" layoutY="38.0" prefHeight="168.0" prefWidth="326.0">
        <columns>
          <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Nome" />
          <TableColumn fx:id="urlColumn" prefWidth="165.0" text="URL" />
        </columns>
      </TableView>
      <Accordion layoutX="35.0" layoutY="239.0" />
      <Button fx:id="deletar" layoutX="582.0" layoutY="219.0" onAction="#deletar" text="Deletar" />
      <Button fx:id="concluirEdicao" layoutX="121.0" layoutY="242.0" onAction="#concluirEdicao" text="Concluir edição" />
      <TableView fx:id="categoryTable" layoutX="369.0" layoutY="279.0" prefHeight="109.0" prefWidth="268.0">
        <columns>
            <TableColumn fx:id="categoryName" prefWidth="128.0" text="Nome" />
          <TableColumn fx:id="categoryDescription" prefWidth="137.0" text="Descrição" />
        </columns>
      </TableView>
      <Label fx:id="labelCategory" layoutX="369.0" layoutY="254.0" text="Categorias" />
      <Label layoutX="369.0" layoutY="14.0" text="NFTs" />
        <Label fx:id="label" layoutX="86.0" layoutY="409.0" minHeight="16" minWidth="69">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="editar" layoutX="368.0" layoutY="219.0" onAction="#editar" text="Editar" />
      <Button fx:id="voltar" layoutX="367.0" layoutY="219.0" onAction="#sairEdicao" text="Voltar" />
      <Button layoutX="355.0" layoutY="441.0" mnemonicParsing="false" onAction="#goToCategory" text="Categorias" />
      <Button layoutX="537.0" layoutY="441.0" mnemonicParsing="false" onAction="#goToPurchase" text="Suas Compras" />
      <Button fx:id="showCategories" layoutX="437.0" layoutY="219.0" mnemonicParsing="false" onAction="#showCategories" text="Mostrar categorias" />
    </children>
</AnchorPane>
